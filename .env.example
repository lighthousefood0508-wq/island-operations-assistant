# Development-safe placeholders only. This repository does not load .env files;
# an approved process supervisor supplies production environment values.
# Never copy Legacy or production credentials here.
NODE_ENV=development
ROS_PORT=3090
ROS_HOST=127.0.0.1
ROS_DATABASE_PATH=./data/ros-v2-dev.sqlite

# Authentication is disabled by default only outside production. In production:
# NODE_ENV=production
# ROS_AUTH_MODE=required
# ROS_AUTH_SECURE_COOKIE=true
# ROS_PUBLIC_ORIGIN=https://ros.example.invalid
# ROS_DATABASE_PATH=/var/lib/desert-island-ros/ros.sqlite
# ROS_HOST=127.0.0.1
# ROS_BACKUP_DIRECTORY=/var/backups/desert-island-ros
# ROS_BACKUP_RETENTION_COUNT=14
# ROS_BACKUP_MAX_AGE_HOURS=26
ROS_AUTH_MODE=disabled
ROS_AUTH_SECURE_COOKIE=false
ROS_AUTH_SESSION_TTL_MINUTES=720
# Bootstrap values are environment-only and required only for the first
# production credentialed administrator. Do not commit real values.
ROS_BOOTSTRAP_ADMIN_LOGIN=
ROS_BOOTSTRAP_ADMIN_PASSWORD=
ROS_BOOTSTRAP_ADMIN_DISPLAY_NAME=

# Future integrations: leave blank until separately approved.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
OPENAI_API_KEY=
GOOGLE_SHEETS_ID=
N8N_WEBHOOK_URL=

# Temporary external Shadow Run only. Set in the current shell; never commit a value.
ROS_TUNNEL_BASIC_AUTH=
