[Unit]
Description=Desert Island ROS local health and backup-freshness evidence
After=network-online.target desert-island-ros.service
Wants=network-online.target

[Service]
Type=oneshot
User=ros
Group=ros
WorkingDirectory=/opt/desert-island-ros/current
EnvironmentFile=/etc/desert-island-ros/ros.env
ExecStart=/usr/bin/node /opt/desert-island-ros/current/scripts/production-monitoring-evidence.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/backups/desert-island-ros
